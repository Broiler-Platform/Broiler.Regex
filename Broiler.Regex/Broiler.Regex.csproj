<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Broiler.Regex — a from-scratch, ECMAScript-conformant regular-expression
    engine for the Broiler.JS runtime.

    It references no JS engine, runtime, or System.Text.RegularExpressions type.
    That keeps it independently testable and lets the JavaScript layer adopt it
    incrementally — see README.md for the motivation, the JS/.NET gap analysis,
    and the integration plan. Its only dependency is the Unicode owner's provider
    below (requirement R11, decision D11 of Broiler.VM's JSD-0081): the caller hands
    its tables in as an IUnicodeTables, and `\p{…}`, the `v`-mode class sets, case
    folding and group names are answered from them. Broiler.Unicode.Tables, the
    owner's tables, is referenced by the tests and the probe only.
  -->
  <PropertyGroup>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <RootNamespace>Broiler.Regex</RootNamespace>
    <AssemblyName>Broiler.Regex</AssemblyName>
  </PropertyGroup>

  <!--
    Package validation (the programme's convention 16, rule SL6): every pack is compared with the
    last published package, 0.1.0-preview.4, which NuGet restores from nuget.org as the baseline. A
    break the SJL-11 work makes on purpose (decision D12 of Broiler.VM's JSD-0081) is suppressed in
    CompatibilitySuppressions.xml beside this file, listed in docs/suppressions.md and recorded in
    CHANGELOG.md under Changed with its R item; until then there is none, and a break fails the pack.
  -->
  <PropertyGroup>
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>0.1.0-preview.4</PackageValidationBaselineVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Broiler.Unicode.Algorithms" />
  </ItemGroup>

  <!--
    The new backend's match entry (Broiler.Regex.Engine, task 2.4a of SJL-11.2) is internal until task 2.4c routes
    BroilerRegex through it and makes it public. Until then the tests and the Native AOT probe reach it, and nothing
    else does.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="Broiler.Regex.Tests" />
    <InternalsVisibleTo Include="Broiler.Regex.Probe" />
  </ItemGroup>

</Project>
