<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Broiler.Regex — a from-scratch, ECMAScript-conformant regular-expression
    engine for the Broiler.JS runtime.

    It references no JS engine, runtime, or System.Text.RegularExpressions type.
    That keeps it independently testable and lets the JavaScript layer adopt it
    incrementally — see README.md for the motivation, the JS/.NET gap analysis,
    and the integration plan. Its only dependency is the Unicode owner's provider
    below (requirement R11, decision D11 of Broiler.VM's JSD-0081): the caller hands
    its tables in as an IUnicodeTables, and `\p{…}`, the `v`-mode class sets, case
    folding and group names are answered from them. Broiler.Unicode.Tables, the
    owner's tables, is referenced by the tests and the probe only.
  -->
  <PropertyGroup>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <RootNamespace>Broiler.Regex</RootNamespace>
    <AssemblyName>Broiler.Regex</AssemblyName>
  </PropertyGroup>

  <!--
    Package validation (the programme's convention 16, rule SL6): every pack is compared with the
    last published package, which NuGet restores from nuget.org as the baseline: 0.1.0-preview.5,
    which the owner published on 2026-10-29 from 24344b3 (it was 0.1.0-preview.4 until task 2.9 of
    SJL-11.2). A break the SJL-11 work makes on purpose (decision D12 of Broiler.VM's JSD-0081) is
    suppressed in CompatibilitySuppressions.xml beside this file, listed in docs/suppressions.md and
    recorded in CHANGELOG.md under Changed with its R item; the file holds only the breaks of what a
    consumer can have, so a break that 0.1.0-preview.5 already shipped leaves it and stays listed in
    those two records. Any other break fails the pack.
  -->
  <PropertyGroup>
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>0.1.0-preview.5</PackageValidationBaselineVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Broiler.Unicode.Algorithms" />
  </ItemGroup>

  <!--
    The tests and the Native AOT probe reach the library's internals: the program, the machine and its observer, and
    the internal entry that reports the units a call did, which BroilerRegex's public offset entry (task 2.4c of
    SJL-11.2) leaves to the meter.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="Broiler.Regex.Tests" />
    <InternalsVisibleTo Include="Broiler.Regex.Probe" />
  </ItemGroup>

</Project>
