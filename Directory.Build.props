<Project>
  <Import Project="$(MSBuildThisFileDirectory)eng/Broiler.Packaging.props" />

  <!--
    This repository's preview stream (docs/publishing.md, "Choose the version"). The vendored packaging props set the
    suite's floor, 0.1.0-preview.1, and are not edited here; this floor wins over it, as Broiler.ECMAScript's own stream
    does in Broiler.JS. The owner's decision of 2026-11-01 ("Please keep using version 0.1.0-x scheme!") keeps the SJL-11
    surface in the 0.1.0-preview.N stream, where decision D12 of Broiler.VM's JSD-0081 had put it at 0.2.0-preview.1.
    The owner published 0.1.0-preview.5 on 2026-10-29, so the next is 0.1.0-preview.6: a local pack gives it, and
    eng/resolve-preview-version.mjs still goes past every version nuget.org or eng/preview-version-history.json holds.
  -->
  <PropertyGroup>
    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionSuffix>preview.6</VersionSuffix>
  </PropertyGroup>

  <!--
    Every project of this repository. The shared JavaScript libraries programme's convention 17
    (docs/conventions.md): net10.0, nullable enabled, implicit usings disabled so that every type a
    source uses is traceable from that source, warnings as errors, deterministic builds and no unsafe
    code. Rule SL5 of tests/Regex.Architecture.Tests reads these as MSBuild evaluates them.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Configurations>Debug;Release</Configurations>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <PackageProjectUrl>https://github.com/Broiler-Platform/Broiler.RegEx</PackageProjectUrl>
    <PackageTags>broiler;regex;ecmascript;regexp</PackageTags>
    <Description>Experimental .NET 10 regular-expression engine implementing ECMAScript matching semantics for Broiler.JS. Preview with documented limitations.</Description>
  </PropertyGroup>

  <!--
    Convention 12, Native AOT and trimming, for the library and for the Native AOT probe: both are
    declared AOT-compatible and trimmable, so the trim, AOT and single-file analyzers run over them, and
    what those analyzers report is an error under TreatWarningsAsErrors above. Nothing is suppressed
    (docs/suppressions.md). The test projects, whose names end in ".Tests" as the packaging props'
    IsPackable convention already reads them, run under the JIT only and are not held: their reflection
    over test assemblies is what xunit and the architecture rules are for. tests/Regex.Fuzz, the fuzz
    target, is a test project whose name does not end in ".Tests", so neither condition reaches it: its
    own project file sets these five properties back to false, and IsPackable to false.
  -->
  <PropertyGroup Condition="!$(MSBuildProjectName.EndsWith('.Tests'))">
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
  </PropertyGroup>
</Project>
