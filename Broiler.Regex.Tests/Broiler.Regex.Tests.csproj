<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Broiler.Regex.Tests</RootNamespace>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" />
    <!-- The Unicode owner's tables, handed to every compilation as its IUnicodeTables: test-only data (R11, decision D11). -->
    <PackageReference Include="Broiler.Unicode.Tables" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Broiler.Regex\Broiler.Regex.csproj" />
    <!-- Built first and run from its own output: AdversarialCorpusTests runs each corpus row in a child process of the
         probe. An executable is not referenced as an assembly. -->
    <ProjectReference Include="..\probes\Regex.Probe\Regex.Probe.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <!-- The adversarial corpus's one reader and its expressions' one evaluator, which the probe's child processes and its
         adversarial mode run on, and the mode's judgement of a child, read here by the tests of the corpus (task 2.14). -->
    <Compile Include="..\probes\Regex.Probe\AdversarialCorpus.cs" Link="Probe\AdversarialCorpus.cs" />
    <Compile Include="..\probes\Regex.Probe\EngineRun.cs" Link="Probe\EngineRun.cs" />
    <Compile Include="..\probes\Regex.Probe\AdversarialMode.cs" Link="Probe\AdversarialMode.cs" />
  </ItemGroup>
</Project>
