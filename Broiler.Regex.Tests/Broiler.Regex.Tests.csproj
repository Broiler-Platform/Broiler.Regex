<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Broiler.Regex.Tests</RootNamespace>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" />
    <!-- The Unicode owner's tables, handed to every compilation as its IUnicodeTables: test-only data (R11, decision D11). -->
    <PackageReference Include="Broiler.Unicode.Tables" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Broiler.Regex\Broiler.Regex.csproj" />
    <!-- Built first and run from its own output: AdversarialCorpusTests runs each corpus row in a child process of the
         probe. An executable is not referenced as an assembly. -->
    <ProjectReference Include="..\probes\Regex.Probe\Regex.Probe.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
